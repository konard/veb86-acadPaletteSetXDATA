<UserControl x:Class="AcadPaletteSetXData.UI.PaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AcadPaletteSetXData.UI"
             Background="{DynamicResource PaletteBackground}"
             Foreground="{DynamicResource PaletteForeground}"
             FontFamily="Segoe UI" FontSize="13"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             AutomationProperties.Name="Панель XDATA">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource PaletteForeground}" /></Style>
            <DataTemplate x:Key="{DataTemplateKey {x:Static ui:ViewModelTypes.Grid}}"><ui:PropertyGridView /></DataTemplate>
            <DataTemplate x:Key="{DataTemplateKey {x:Static ui:ViewModelTypes.Navigator}}"><ui:NavigatorView /></DataTemplate>
            <HierarchicalDataTemplate x:Key="{DataTemplateKey {x:Static ui:ViewModelTypes.Node}}" ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding DisplayText}" ToolTip="{Binding Value}" />
            </HierarchicalDataTemplate>
            <DataTemplate x:Key="{DataTemplateKey {x:Static ui:ViewModelTypes.Selection}}">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Расширенные данные" FontWeight="SemiBold" Margin="0,4,0,8" />
                    <!-- The object of the tree; the list above the panel groups the selection (issue #41). -->
                    <ComboBox x:Name="SelectedEntityField" Grid.Row="1" Margin="0,0,0,8" ItemsSource="{Binding Entities}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedEntity, Mode=TwoWay}" IsEnabled="{Binding HasSelection}"
                              AutomationProperties.Name="Объект для просмотра дерева XDATA" ToolTip="Выбор объекта меняет только дерево XDATA. Вкладка «Свойства» показывает всё выделение.">
                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding Entities.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger></Style.Triggers>
                        </Style></ComboBox.Style>
                    </ComboBox>
                    <TextBlock Grid.Row="2" Text="{Binding Diagnostics}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource PaletteMuted}" />
                    <TreeView Grid.Row="3" ItemsSource="{Binding Tree}" IsEnabled="{Binding HasSelection}" Style="{StaticResource ThemedTreeView}"
                              Background="{DynamicResource PaletteBackground}" Foreground="{DynamicResource PaletteForeground}"
                              BorderBrush="{DynamicResource PaletteBorder}" AutomationProperties.Name="Дерево XDATA">
                        <TreeView.Resources><Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                            <Setter Property="Foreground" Value="{DynamicResource PaletteForeground}" />
                        </Style></TreeView.Resources>
                    </TreeView>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="{DataTemplateKey {x:Static ui:ViewModelTypes.Tab}}">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Background="{DynamicResource PaletteTabBackground}" Padding="10,8">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource PaletteMuted}" />
                    </ScrollViewer>
                </Grid>
            </DataTemplate>
            <Style x:Key="GroupButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="3,0,0,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Selection.HasSelection}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource PaletteForeground}" />
                <Setter Property="Background" Value="{DynamicResource PaletteTabBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PaletteBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="9,16" />
                <Setter Property="Margin" Value="0,0,0,3" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}" CornerRadius="0,3,3,0">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background"
                                            Value="{DynamicResource PaletteHoverBackground}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background"
                                            Value="{DynamicResource PaletteSelectedBackground}" />
                                    <Setter TargetName="TabBorder" Property="BorderBrush"
                                            Value="{DynamicResource PaletteAccent}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="TabBorder" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="6,6,6,4">
            <!-- Issue #41: the selection grouped by SYSTEMTYPE or by the AutoCAD name of the object type, «Все (N)» for
                 more than one group; * keeps only the chosen group selected, − removes it from the selection. -->
            <Grid x:Name="GroupBar" Height="31">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="SelectedGroupField" ItemsSource="{Binding Selection.Groups}" DisplayMemberPath="Text"
                          SelectedItem="{Binding Selection.SelectedGroup, Mode=TwoWay}"
                          IsEnabled="{Binding HasItems, RelativeSource={RelativeSource Self}}"
                          AutomationProperties.Name="Группа выделенных объектов"
                          ToolTip="Объекты выделения по SYSTEMTYPE или по типу объекта AutoCAD; кнопки * и − работают с выбранной группой." />
                <TextBlock x:Name="SelectionPlaceholder" Text="Выберите объекты на чертеже"
                           Foreground="{DynamicResource PaletteMuted}" VerticalAlignment="Center" Margin="6,0,25,0"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=SelectedGroupField}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="KeepGroupButton" Grid.Column="1" Content="*" Style="{StaticResource GroupButton}"
                        Command="{Binding Selection.KeepGroupCommand}"
                        AutomationProperties.Name="Оставить только группу" ToolTip="Оставить выделенными только объекты выбранной группы" />
                <Button x:Name="ExcludeGroupButton" Grid.Column="2" Content="−" Style="{StaticResource GroupButton}"
                        Command="{Binding Selection.ExcludeGroupCommand}"
                        AutomationProperties.Name="Исключить группу" ToolTip="Снять выделение с объектов выбранной группы" />
            </Grid>
            <TextBlock Text="{Binding Selection.Status}" TextWrapping="Wrap" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Selection.Status}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    <TabControl x:Name="Tabs" Grid.Row="1" TabStripPlacement="Right"
                ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                Background="{DynamicResource PaletteBackground}"
                Foreground="{DynamicResource PaletteForeground}"
                BorderBrush="{DynamicResource PaletteBorder}" BorderThickness="0">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,1,0" Background="{TemplateBinding Background}">
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </Border>
                    <TabPanel Grid.Column="1" IsItemsHost="True" VerticalAlignment="Top"
                              KeyboardNavigation.TabIndex="0" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>
        <TabControl.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Header}">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="270" />
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
            <DataTemplate>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentControl Content="{Binding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <TextBlock Grid.Row="1" Text="● задано, ○ по умолчанию, ƒ вычисляемое, ! ошибка" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource PaletteMuted}" Margin="6,8" />
                </Grid>
            </DataTemplate>
        </TabControl.ContentTemplate>
    </TabControl>
    </Grid>
</UserControl>
