<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <ProjectReference Include="../../src/AcadPaletteSetXData.Core/AcadPaletteSetXData.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../examples/schema.json" Link="examples/schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/tzxdata-stage10-load-schema.json" Link="examples/tzxdata-stage10-load-schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/issue41-template-systemtype-schema.json" Link="examples/issue41-template-systemtype-schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/issue48-system-group-schema.json" Link="examples/issue48-system-group-schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/issue43-formula-schema.json" Link="examples/issue43-formula-schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/issue61-repeat-schema.json" Link="examples/issue61-repeat-schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Issue #57: the old logging abstractions an AutoCAD component may have loaded already (no NullLoggerFactory). -->
    <PackageDownload Include="Microsoft.Extensions.Logging.Abstractions" Version="[1.1.1]" />
    <None Include="$(NuGetPackageRoot)microsoft.extensions.logging.abstractions/1.1.1/lib/netstandard1.1/Microsoft.Extensions.Logging.Abstractions.dll" Link="legacy/Microsoft.Extensions.Logging.Abstractions.dll" CopyToOutputDirectory="PreserveNewest" Condition="'$(NuGetPackageRoot)' != ''" />
  </ItemGroup>
</Project>
