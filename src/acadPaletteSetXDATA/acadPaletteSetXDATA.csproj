<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>acadPaletteSetXDATA</AssemblyName>
    <RootNamespace>acadPaletteSetXDATA</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.0.0</Version>
    <!-- Keep CLR/file versions within their 16-bit limits as the CI run number grows. -->
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Build-only foundation: no AutoCAD commands at this stage. -->
  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="[24.0.0]" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
