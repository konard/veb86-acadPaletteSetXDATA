<Window x:Class="AcadPaletteSetXData.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки панели XDATA" Width="440" SizeToContent="Height" MinWidth="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource PaletteBackground}" Foreground="{DynamicResource PaletteForeground}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="Настройки панели XDATA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- A checkbox with its caption: a click on the text toggles it too. -->
            <Style x:Key="Option" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource PaletteForeground}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Box" Width="16" Height="16" VerticalAlignment="Center" Background="{DynamicResource PaletteBackground}"
                                        BorderBrush="{DynamicResource PaletteBorder}" BorderThickness="1">
                                    <Path x:Name="Tick" Visibility="Collapsed" Data="M 2,7 L 6,11 L 12,3"
                                          Stroke="{DynamicResource PaletteForeground}" StrokeThickness="2" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible" /></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PaletteAccent}" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PaletteAccent}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Wide" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="12,3" />
                <Setter Property="Margin" Value="6,0,0,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Root" Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="Вкладка «Свойства»" FontWeight="SemiBold" Margin="0,0,0,8" />
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <CheckBox x:Name="ShowSystemGroupBox" Style="{StaticResource Option}" IsChecked="{Binding ShowSystemGroup, Mode=TwoWay}"
                      Content="Показывать скрытую группу SYSTEM"
                      AutomationProperties.Name="Показывать скрытую группу SYSTEM"
                      ToolTip="Параметры группы схемы SYSTEM — служебные и по умолчанию скрыты от пользователя." />
            <TextBlock Margin="24,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource PaletteMuted}"
                       Text="Параметры группы SYSTEM — служебные данные. Без отметки они не показываются в списке свойств и в меню «+ Параметр»." />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="ОК" Style="{StaticResource Wide}" IsDefault="True" Click="OnOk"
                    AutomationProperties.Name="ОК" ToolTip="Применить и сохранить настройки" />
            <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource Wide}" IsCancel="True" Click="OnCancel"
                    AutomationProperties.Name="Отмена" ToolTip="Закрыть без изменений" />
        </StackPanel>
    </Grid>
</Window>
