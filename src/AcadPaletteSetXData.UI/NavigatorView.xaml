<UserControl x:Class="AcadPaletteSetXData.UI.NavigatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AcadPaletteSetXData.UI"
             AutomationProperties.Name="Навигатор объектов">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Controls.xaml" /></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />
            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,3,0" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            </Style>
            <!-- ▸/▾ of a group; hidden but space-keeping on objects so that captions align. -->
            <Style x:Key="ExpandButton" TargetType="Button">
                <Setter Property="Width" Value="14" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Foreground" Value="{DynamicResource PaletteForeground}" />
                <Setter Property="Content" Value="{Binding Glyph}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasChildren}" Value="False"><Setter Property="Visibility" Value="Hidden" /></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource PaletteAccent}" /></Trigger>
                </Style.Triggers>
            </Style>
            <!-- Groups are semi-bold; «Не задано» is grey italic; a group of objects with errors is red. -->
            <Style x:Key="CaptionText" TargetType="TextBlock">
                <Setter Property="Text" Value="{Binding Caption}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsGroup}" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                    <DataTrigger Binding="{Binding IsEmptyValue}" Value="True">
                        <Setter Property="FontStyle" Value="Italic" />
                        <Setter Property="Foreground" Value="{DynamicResource PaletteMuted}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PaletteError}" /></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ColumnHeader" TargetType="GridViewColumnHeader">
                <Setter Property="Foreground" Value="{DynamicResource PaletteMuted}" />
                <Setter Property="Background" Value="{DynamicResource PaletteTabBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PaletteBorder}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="ToolTip" Value="Щелчок — сортировка, перетаскивание — порядок, граница — ширина, правая кнопка — видимость колонок" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Grid>
                                <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1" Padding="5,3">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                </Border>
                                <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6" Margin="0,0,-3,0" Cursor="SizeWE">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource PaletteHoverBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- The empty filler right of the last column. -->
                    <Trigger Property="Role" Value="Padding"><Setter Property="ToolTip" Value="{x:Null}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Row" TargetType="ListViewItem">
                <Setter Property="Foreground" Value="{DynamicResource PaletteForeground}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource PaletteTabBackground}" />
                <Setter Property="Height" Value="24" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Caption}" />
                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1">
                                <GridViewRowPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PaletteHoverBackground}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PaletteSelectedBackground}" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PaletteAccent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsGroup}" Value="True"><Setter Property="Background" Value="{DynamicResource PaletteTabBackground}" /></DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Text="Навигатор объектов" FontWeight="SemiBold" Margin="6,6,6,2" />
        <!-- The top bar: the profile, «Обновить», expanding and the profile menu «⚙». -->
        <DockPanel x:Name="Toolbar" Grid.Row="1" Height="32" Margin="6,0" LastChildFill="True" AutomationProperties.Name="Панель навигатора">
            <Button x:Name="RefreshButton" DockPanel.Dock="Left" Content="⟳" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="Обновить" ToolTip="Перечитать объекты чертежа и перестроить дерево" />
            <Button x:Name="ExpandAllButton" DockPanel.Dock="Left" Content="⊞" Style="{StaticResource ToolButton}" Command="{Binding ExpandAllCommand}"
                    AutomationProperties.Name="Развернуть все" ToolTip="Развернуть все группы" />
            <Button x:Name="CollapseAllButton" DockPanel.Dock="Left" Content="⊟" Style="{StaticResource ToolButton}" Command="{Binding CollapseAllCommand}"
                    AutomationProperties.Name="Свернуть все" ToolTip="Свернуть все группы" />
            <Button x:Name="ProfileMenuButton" DockPanel.Dock="Right" Content="⚙" Style="{StaticResource ToolButton}" Margin="3,0,0,0" Click="OnProfileMenu"
                    AutomationProperties.Name="Профили навигатора" ToolTip="Настройка, импорт и экспорт профилей навигатора">
                <Button.ContextMenu><ContextMenu x:Name="ProfileMenu" Placement="Custom" /></Button.ContextMenu>
            </Button>
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="✓" Style="{StaticResource ToolButton}" Margin="3,0,0,0" Command="{Binding SaveCommand}"
                    AutomationProperties.Name="Сохранить профиль" ToolTip="Сохранить ширину, порядок и видимость колонок в профиле" />
            <ComboBox x:Name="ProfileField" Height="24" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                      AutomationProperties.Name="Профиль навигатора" ToolTip="Профиль: выражение дерева и колонки. Переключается без перезапуска." />
        </DockPanel>
        <!-- Problems of profiles and of reading the drawing; the tree stays usable. -->
        <ScrollViewer x:Name="DiagnosticsPanel" Grid.Row="2" MaxHeight="72" Margin="6,0,6,4" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasDiagnostics, Converter={StaticResource Visible}}">
            <ItemsControl x:Name="DiagnosticsList" ItemsSource="{Binding Diagnostics}" AutomationProperties.Name="Сообщения навигатора">
                <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource PaletteError}" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <ListView x:Name="Rows" Grid.Row="3" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" SelectionMode="Single"
                  Style="{StaticResource ThemedListView}" ItemContainerStyle="{StaticResource Row}" Background="{DynamicResource PaletteBackground}"
                  Foreground="{DynamicResource PaletteForeground}" BorderBrush="{DynamicResource PaletteBorder}" BorderThickness="0,1,0,0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  KeyboardNavigation.DirectionalNavigation="Contained" AutomationProperties.Name="Дерево объектов">
            <!-- Issue #68: the menu of a group, filled when it opens; objects have no menu. -->
            <ListView.ContextMenu><ContextMenu x:Name="RowMenu" /></ListView.ContextMenu>
            <ListView.View>
                <GridView x:Name="Columns" ColumnHeaderContainerStyle="{StaticResource ColumnHeader}" AllowsColumnReorder="True">
                    <GridView.ColumnHeaderContextMenu>
                        <ContextMenu x:Name="ColumnMenu" />
                    </GridView.ColumnHeaderContextMenu>
                    <GridViewColumn x:Name="TreeColumn">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel Margin="{Binding Indent, Converter={x:Static ui:NavigatorView.Indent}}">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource ExpandButton}" Margin="0,0,3,0"
                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="Развернуть или свернуть" />
                                    <TextBlock Style="{StaticResource CaptionText}" />
                                </DockPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock x:Name="StatusText" Grid.Row="4" Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="6,4,6,0"
                   Foreground="{DynamicResource PaletteMuted}" />
    </Grid>
</UserControl>
